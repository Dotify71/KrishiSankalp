# KrishiSankalp Environment Variables Example
# Copy this to .env and fill in the values

# API Keys
WEATHER_API_KEY=your_openweathermap_api_key
KINDWISE_TOKEN=your_kindwise_plant_id_token
AGRO_API_KEY=your_agromonitoring_api_key
GOVT_DATA_API_KEY=your_data_gov_in_api_key
TREFLE_TOKEN=your_trefle_api_token

# Database (Optional, defaults to SQLite)
DATABASE_URL=sqlite:///./krishi.db
# DATABASE_URL=postgresql://user:password@localhost:5432/krishisankalp

# Render Specific (Optional)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
